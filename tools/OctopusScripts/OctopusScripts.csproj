<Project Sdk="Microsoft.NET.Sdk">
  <!-- OctopusScripts.dll: compiles and checks AI-written C# scripts with Roslyn. The add-in loads it, with its own copy
       of Roslyn, in a separate AssemblyLoadContext from the "scripts" subfolder, so other add-ins that ship another
       Roslyn version (pyRevit ships 4.10 and 4.13) are never affected. No Revit references: it is tested without Revit. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>OctopusScripts</AssemblyName>
    <RootNamespace>RevitProjectBrain.Scripts</RootNamespace>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="[4.11.0]" />
  </ItemGroup>
</Project>
